HOST=127.0.0.1
PORT=8080
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional: live PostgreSQL corridor catalog. No sample corridors are seeded.
# DATABASE_URL=postgres://user:password@localhost:5432/stealthbridge
# Optional: enables bearer-authenticated /internal/metrics. Leave unset to disable it.
# STEALTHBRIDGE_METRICS_TOKEN=
RUST_LOG=info

# Non-financial encrypted instruction storage; requires migration 202611120001.
# Keep false until the reviewed migration is applied to the intended database.
STEALTHBRIDGE_PAYMENT_INSTRUCTIONS_ENABLED=false
# Shared server-only BFF authentication secret, at least 32 bytes. Never NEXT_PUBLIC.
# STEALTHBRIDGE_ACCOUNT_BRIDGE_SECRET=
